<?xml version="1.0" encoding="utf-8"?>
<!-- NovaOS Mobile: the NovaOS home screen for Android phones and tablets (a launcher,
     like Samsung's One UI Home). Android underneath stays as it is (updates, security);
     NovaOS Mobile can be switched off again in the Android settings at any time.
     Internet for TV channels (broadcasters' streams), Nova Filme (YouTube), Nova Store
     (F-Droid), the NovaOS software update (ghcr.io), Nova Chat (Matrix) and Nova Mail (the
     user's own mail provider over IMAP/SMTP with TLS). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.novaos.mobile">

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- "Uninstall" in the app menu opens the system uninstall dialog -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- swipe down on the home screen opens the notifications -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- software update and Nova Store: Android asks the user before every installation -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- "System software update available" notification (Android 13+ asks the user) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- the background update check keeps running after the phone restarts -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Nova (assistant): listen to "Hey Nova" and commands, call contacts, weather here, alarms/timers -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Nova Karte: exact position for navigation (GPS) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Nova Chat calls -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Nova Kamera -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Nova Galerie (Android 13+: photos and videos; before: storage) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- Nova Dateien (Android 11+: "All files access", asked in the Android settings) -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Nova Family on a child's phone: the protection runs all the time (foreground service),
         the lock screen covers other apps, calls always work, blocked apps are noticed -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Nova Musik: playing in the background, songs on the phone -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- account and Nova apps: confirm with fingerprint/face or the screen lock (Android asks) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />

    <!-- Android 11+: apps the home screen may list and start -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="content" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_TIMER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.WEB_SEARCH" />
        </intent>
        <package android:name="com.google.android.youtube" />
        <package android:name="com.android.vending" />
    </queries>

    <application
        android:name=".NovaApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/Theme.NovaMobile"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security">

        <!-- home screen: can be chosen as the phone's start screen -->
        <activity
            android:name=".HomeActivity"
            android:clearTaskOnLaunch="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".AppsActivity"
            android:exported="false"
            android:theme="@style/Theme.NovaMobile.Drawer"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".TvActivity"
            android:exported="false" />
        <activity
            android:name=".PlayerActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.NovaMobile.Player" />
        <activity
            android:name=".FilmeActivity"
            android:exported="false" />
        <activity
            android:name=".VideoActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:theme="@style/Theme.NovaMobile.Player" />

        <!-- NovaOS's own apps: in the app overview and as icons in any home screen -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:icon="@mipmap/ic_nova_settings"
            android:label="@string/app_settings"
            android:taskAffinity="org.novaos.mobile.settings">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MapActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:icon="@mipmap/ic_nova_map"
            android:label="@string/app_map"
            android:launchMode="singleTask"
            android:taskAffinity="org.novaos.mobile.map"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- other apps can show places and addresses ("geo:53.55,10.0?q=Hauptbahnhof") -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="geo" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MusicActivity"
            android:exported="true"
            android:icon="@mipmap/ic_nova_music"
            android:label="@string/app_music"
            android:launchMode="singleTask"
            android:taskAffinity="org.novaos.mobile.music"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".MusicService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <activity
            android:name=".AccountActivity"
            android:exported="false"
            android:taskAffinity="org.novaos.mobile.settings" />
        <activity
            android:name=".ConfirmActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.NovaMobile.Confirm" />
        <activity
            android:name=".ShopActivity"
            android:exported="true"
            android:icon="@mipmap/ic_nova_shop"
            android:label="@string/app_shop"
            android:taskAffinity="org.novaos.mobile.shop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".PhoneDetailActivity"
            android:exported="false"
            android:taskAffinity="org.novaos.mobile.shop" />
        <activity
            android:name=".NovaAppDetailActivity"
            android:exported="false"
            android:taskAffinity="org.novaos.mobile.store" />
        <activity
            android:name=".NewsActivity"
            android:exported="false"
            android:taskAffinity="org.novaos.mobile.store" />
        <activity
            android:name=".StoreDetailActivity"
            android:exported="false"
            android:taskAffinity="org.novaos.mobile.store" />
        <activity
            android:name=".StoreActivity"
            android:exported="true"
            android:icon="@mipmap/ic_nova_store"
            android:label="@string/app_store"
            android:taskAffinity="org.novaos.mobile.store">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".CameraActivity"
            android:exported="true"
            android:icon="@mipmap/ic_nova_camera"
            android:label="@string/app_camera"
            android:taskAffinity="org.novaos.mobile.camera"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.NovaMobile.Player">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".GalleryActivity"
            android:exported="true"
            android:icon="@mipmap/ic_nova_gallery"
            android:label="@string/app_gallery"
            android:taskAffinity="org.novaos.mobile.gallery">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".FilesActivity"
            android:exported="true"
            android:icon="@mipmap/ic_nova_files"
            android:label="@string/app_files"
            android:taskAffinity="org.novaos.mobile.files">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".NotesActivity"
            android:exported="true"
            android:icon="@mipmap/ic_nova_notes"
            android:label="@string/app_notes"
            android:taskAffinity="org.novaos.mobile.notes">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".NovaActivity"
            android:exported="true"
            android:icon="@mipmap/ic_nova_nova"
            android:label="@string/app_nova"
            android:launchMode="singleTop"
            android:taskAffinity="org.novaos.mobile.nova"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ChatActivity"
            android:exported="true"
            android:icon="@mipmap/ic_nova_chat"
            android:label="@string/app_chat"
            android:launchMode="singleTask"
            android:taskAffinity="org.novaos.mobile.chat"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- back from the browser login (Matrix SSO) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="org.novaos.mobile" android:host="chat-login" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MailActivity"
            android:exported="true"
            android:icon="@mipmap/ic_nova_mail"
            android:label="@string/app_mail"
            android:launchMode="singleTask"
            android:taskAffinity="org.novaos.mobile.mail"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MailContactsActivity"
            android:exported="false"
            android:taskAffinity="org.novaos.mobile.mail"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".MailReadActivity"
            android:exported="false"
            android:taskAffinity="org.novaos.mobile.mail" />
        <!-- also for "mailto:" links of other apps -->
        <activity
            android:name=".MailComposeActivity"
            android:exported="true"
            android:label="@string/app_mail"
            android:taskAffinity="org.novaos.mobile.mail"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mailto" />
            </intent-filter>
        </activity>
        <activity
            android:name=".FamilyActivity"
            android:exported="true"
            android:icon="@mipmap/ic_nova_family"
            android:label="@string/app_family"
            android:launchMode="singleTask"
            android:taskAffinity="org.novaos.mobile.family"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Nova Family: lock screen without the overlay permission -->
        <activity
            android:name=".LockActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:taskAffinity="org.novaos.mobile.lock"
            android:theme="@style/Theme.NovaMobile.Player"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".RoomActivity"
            android:exported="false"
            android:taskAffinity="org.novaos.mobile.chat"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".CallActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:taskAffinity="org.novaos.mobile.call"
            android:theme="@style/Theme.NovaMobile.Player" />
        <activity
            android:name=".ChatContactsActivity"
            android:exported="false"
            android:taskAffinity="org.novaos.mobile.chat" />
        <activity
            android:name=".ViewerActivity"
            android:configChanges="orientation|screenLayout|screenSize|smallestScreenSize"
            android:exported="false"
            android:theme="@style/Theme.NovaMobile.Player" />
        <activity
            android:name=".NoteEditActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".UpdateActivity"
            android:exported="false" />
        <!-- "Letztes erfolgreiches Update" (from the software update) -->
        <activity
            android:name=".LastUpdateActivity"
            android:exported="false" />
        <!-- setting up NovaOS on the first start -->
        <activity
            android:name=".SetupActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <!-- start animation (after updates and "Restart NovaOS") -->
        <activity
            android:name=".BootActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.NovaMobile.Player" />

        <!-- result of an installation (update, Nova Store) -->
        <receiver
            android:name=".InstallReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="org.novaos.mobile.INSTALL_STATUS" />
            </intent-filter>
        </receiver>
        <!-- looks for updates in the background every few hours -->
        <service
            android:name=".UpdateJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- Nova Chat: "Ablehnen" in the call notification -->
        <receiver
            android:name=".Calls$Decline"
            android:exported="false" />
        <!-- Nova Chat: looks for new messages every 15 minutes -->
        <service
            android:name=".ChatSync$ChatJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- Nova Family: protection of a child's phone (always running) -->
        <service
            android:name=".FamilyService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Parental control: keeps the child's phone locked during bedtime and when the parents lock it" />
        </service>
        <service
            android:name=".Family$FamilyJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <receiver
            android:name=".Family$Answer"
            android:exported="false" />
        <!-- Nova Family: protection against uninstalling on a child's phone -->
        <receiver
            android:name=".FamilyAdmin"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/family_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- Nova Mail: looks for new mails every 15 minutes -->
        <service
            android:name=".MailSync$MailJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- after a software update: NovaOS starts again with the start animation -->
        <receiver
            android:name=".UpdatedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Nova Dateien: opens and shares files with other apps (read-only, per file) -->
        <provider
            android:name=".NovaFileProvider"
            android:authorities="org.novaos.mobile.files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
