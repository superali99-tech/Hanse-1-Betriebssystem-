<?xml version="1.0" encoding="utf-8"?>
<!-- NovaOS Mobile: the NovaOS home screen for Android phones and tablets (a launcher,
     like Samsung's One UI Home). Android underneath stays as it is (updates, security);
     NovaOS Mobile can be switched off again in the Android settings at any time.
     Internet only for TV channels (broadcasters' streams) and Nova Filme (YouTube). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.novaos.mobile">

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- "Uninstall" in the app menu opens the system uninstall dialog -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- swipe down on the home screen opens the notifications -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

    <!-- Android 11+: apps the home screen may list and start -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <package android:name="com.google.android.youtube" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NovaMobile"
        android:usesCleartextTraffic="false">

        <!-- home screen: can be chosen as the phone's start screen -->
        <activity
            android:name=".HomeActivity"
            android:clearTaskOnLaunch="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".AppsActivity"
            android:exported="false"
            android:theme="@style/Theme.NovaMobile.Drawer"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".TvActivity"
            android:exported="false" />
        <activity
            android:name=".PlayerActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.NovaMobile.Player" />
        <activity
            android:name=".FilmeActivity"
            android:exported="false" />
        <activity
            android:name=".VideoActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:theme="@style/Theme.NovaMobile.Player" />
        <activity
            android:name=".SettingsActivity"
            android:exported="false" />
    </application>
</manifest>
