<?xml version="1.0" encoding="utf-8"?>
<!-- liquid glass pill (search fields, buttons) -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#40FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient android:angle="270" android:startColor="#45FFFFFF" android:endColor="#24FFFFFF" />
            <stroke android:width="1dp" android:color="#38FFFFFF" />
        </shape>
    </item>
</ripple>
