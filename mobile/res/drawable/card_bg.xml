<?xml version="1.0" encoding="utf-8"?>
<!-- liquid glass card (NovaOS 1.5): lighter at the top, a light rim, touch feedback -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#40FFFFFF">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/radius" />
                    <gradient android:angle="270" android:startColor="#40FFFFFF" android:endColor="#1CFFFFFF" />
                    <stroke android:width="1dp" android:color="#2EFFFFFF" />
                </shape>
            </item>
            <!-- the rim catching the light at the top edge -->
            <item android:bottom="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/radius" />
                    <solid android:color="#00000000" />
                    <stroke android:width="1dp" android:color="#24FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
