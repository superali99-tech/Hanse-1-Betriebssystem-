# NovaOS window manager defaults
[Plugins]
blurEnabled=true
contrastEnabled=true
magiclampEnabled=true
squashEnabled=false
wobblywindowsEnabled=false
glideEnabled=false
scaleEnabled=true
dimscreenEnabled=true

[Effect-blur]
BlurStrength=8
NoiseStrength=2

[Desktops]
Number=2
Rows=1

[org.kde.kdecoration2]
library=org.kde.breeze
theme=Breeze
ButtonsOnLeft=
ButtonsOnRight=IAX
BorderSize=Normal

[Windows]
FocusPolicy=ClickToFocus
Placement=Centered

[ElectricBorders]
TopLeft=None

[TabBox]
LayoutName=org.kde.breeze.desktop
