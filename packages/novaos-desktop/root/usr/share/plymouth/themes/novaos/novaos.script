# NovaOS Plymouth theme (script module)
Window.SetBackgroundTopColor(0.043, 0.063, 0.125);
Window.SetBackgroundBottomColor(0.090, 0.055, 0.220);

sw = Window.GetWidth();
sh = Window.GetHeight();

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(sw / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(sh / 2 - logo.image.GetHeight() / 2 - 40);

word.image = Image("wordmark.png");
word.sprite = Sprite(word.image);
word.sprite.SetX(sw / 2 - word.image.GetWidth() / 2);
word.sprite.SetY(sh / 2 + logo.image.GetHeight() / 2 - 10);

dot_image = Image("dot.png");
for (i = 0; i < 5; i++) {
    dots[i] = Sprite(dot_image);
    dots[i].SetX(sw / 2 - 2.5 * 22 + i * 22);
    dots[i].SetY(sh / 2 + logo.image.GetHeight() / 2 + 80);
    dots[i].SetOpacity(0.25);
}

t = 0;
fun refresh_callback() {
    t++;
    for (i = 0; i < 5; i++) {
        phase = (t / 6 - i) % 5;
        if (phase < 0) phase += 5;
        if (phase < 1) dots[i].SetOpacity(1); else dots[i].SetOpacity(0.25);
    }
}
Plymouth.SetRefreshFunction(refresh_callback);

# Password prompt (encrypted disks)
fun display_password_callback(prompt, bullets) {
    msg.image = Image.Text(prompt + "  " + bullets, 1, 1, 1);
    msg.sprite = Sprite(msg.image);
    msg.sprite.SetX(sw / 2 - msg.image.GetWidth() / 2);
    msg.sprite.SetY(sh * 0.78);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback() {
    msg.sprite = Sprite();
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

# Messages ("plymouth display-message"), e.g. while updates are installed.
# (The function is called SetDisplayMessageFunction - checked against
# script.so of Debian 13; an older version of this theme used a wrong name.)
fun message_callback(text) {
    m.image = Image.Text(text, 0.85, 0.85, 0.95);
    m.sprite = Sprite(m.image);
    m.sprite.SetX(sw / 2 - m.image.GetWidth() / 2);
    m.sprite.SetY(sh * 0.80);
}
Plymouth.SetDisplayMessageFunction(message_callback);

fun hide_message_callback(text) {
    m.sprite = Sprite();
}
Plymouth.SetHideMessageFunction(hide_message_callback);

# Offline updates ("plymouth system-update --progress=N"): progress bar
bar.w = 360;
bar.h = 6;
bar.x = sw / 2 - bar.w / 2;
bar.y = sh * 0.80 + 36;
fun system_update_callback(progress) {
    if (!bar.bg) {
        bar.bg_image = Image("dot.png").Scale(bar.w, bar.h);
        bar.bg = Sprite(bar.bg_image);
        bar.bg.SetPosition(bar.x, bar.y, 1);
        bar.bg.SetOpacity(0.25);
    }
    fill = Math.Int(bar.w * progress / 100);
    if (fill < 1) fill = 1;
    bar.fg_image = Image("dot.png").Scale(fill, bar.h);
    bar.fg = Sprite(bar.fg_image);
    bar.fg.SetPosition(bar.x, bar.y, 2);
}
Plymouth.SetSystemUpdateFunction(system_update_callback);
