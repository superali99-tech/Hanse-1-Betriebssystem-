#!/bin/sh
# NovaOS design for desktops that were set up before it: once per user and design
# version, at login. Version 2: the NovaOS taskbar (bottom panel) floating and
# see-through. Version 3: a modern dock - in the middle, as wide as its content,
# a little higher, without spacers, desktop pager and "show desktop" button.
# Version 4: the round NovaOS dock - a dock height of 58 px; the Plasma theme "novaos"
# (large rounded corners, rounded pills behind the apps) is set right below, on its own.
# KWin reloads its settings (blur, shadows, no shake cursor).
# NovaOS 2 (edition file says 2): the "Nebula" wallpaper on the desktop and the lock
# screen, once per user - only where the NovaOS default wallpaper is still set.
# New users get the taskbar from the NovaOS layout directly. Never blocks the login.
VERSION=4
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/novaos"
CONF="${XDG_CONFIG_HOME:-$HOME/.config}"

# --- round NovaOS dock: Plasma theme "novaos", once per user (marker look-theme) ---
# Switched from any Breeze variant (default, breeze-light, breeze-dark) or nothing; a theme
# the user picked himself stays. Written into the user's own plasmarc, so it holds even
# where the system default would not; needs no running Plasma.
theme_of_user() {
	[ -f "$CONF/plasmarc" ] || return 0
	awk '/^\[/{s=($0=="[Theme]")} s&&/^name=/{sub(/^name=/,""); v=$0} END{print v}' "$CONF/plasmarc"
}
write_theme() {
	mkdir -p "$CONF"
	if command -v kwriteconfig6 >/dev/null 2>&1; then
		kwriteconfig6 --notify --file plasmarc --group Theme --key name "$1" 2>/dev/null
		[ "$(theme_of_user)" = "$1" ] && return 0   # checked, not just trusted
	fi
	tmp="$CONF/plasmarc.nova-tmp"
	if [ -f "$CONF/plasmarc" ]; then
		awk -v t="$1" '
			/^\[/ { if (s && !done) { print "name=" t; done = 1 } s = ($0 == "[Theme]") }
			s && /^name=/ { if (!done) { print "name=" t; done = 1 } next }
			{ print }
			END { if (!done) { if (!s) print "[Theme]"; print "name=" t } }' "$CONF/plasmarc" > "$tmp" && mv "$tmp" "$CONF/plasmarc"
	else
		printf '[Theme]\nname=%s\n' "$1" > "$CONF/plasmarc"
	fi
}
if [ -d /usr/share/plasma/desktoptheme/novaos ] && [ "$(cat "$STATE/look-theme" 2>/dev/null)" != novaos ]; then
	case "$(theme_of_user)" in
		""|default|breeze-light|breeze-dark)
			if command -v plasma-apply-desktoptheme >/dev/null 2>&1; then
				plasma-apply-desktoptheme novaos >/dev/null 2>&1 || true
			fi
			[ "$(theme_of_user)" = novaos ] || write_theme novaos ;;
	esac
	mkdir -p "$STATE" && echo novaos > "$STATE/look-theme"
fi

EDITION=$(cat /usr/share/novaos/edition 2>/dev/null || echo 1)
NEBULA="file:///usr/share/wallpapers/NovaNebula/"
need_look=1
[ "$(cat "$STATE/look-version" 2>/dev/null)" = "$VERSION" ] && need_look=0
need_wall=0
if [ "$EDITION" = 2 ] && [ -d /usr/share/wallpapers/NovaNebula ] && \
		[ "$(cat "$STATE/look-edition" 2>/dev/null)" != 2 ]; then
	need_wall=1
fi
[ $need_look = 1 ] || [ $need_wall = 1 ] || exit 0
command -v busctl >/dev/null 2>&1 || exit 0
WALL_SCRIPT='var ds = desktops();
for (var i = 0; i < ds.length; i++) {
    var d = ds[i];
    if (d.wallpaperPlugin != "org.kde.image") {
        continue;
    }
    d.currentConfigGroup = ["Wallpaper", "org.kde.image", "General"];
    var img = String(d.readConfig("Image", ""));
    if (img == "" || img.indexOf("NovaAurora") >= 0 || img.indexOf("/wallpapers/Next") >= 0) {
        d.writeConfig("Image", "'"$NEBULA"'");
    }
}'
LOOK_SCRIPT='var ps = panels();
for (var i = 0; i < ps.length; i++) {
    var p = ps[i];
    if (p.location != "bottom") {
        continue;
    }
    var ws = p.widgets();
    for (var j = 0; j < ws.length; j++) {
        var t = ws[j].type;
        if (t == "org.kde.plasma.panelspacer" || t == "org.kde.plasma.pager" || t == "org.kde.plasma.showdesktop") {
            ws[j].remove();
        }
    }
    p.floating = true;
    p.opacity = "translucent";
    p.lengthMode = "fit";
    p.alignment = "center";
    var gu = (typeof gridUnit !== "undefined") ? gridUnit : 18;
    p.height = 2 * Math.floor(gu * 3.3 / 2);
}'
SCRIPT=""
[ $need_look = 1 ] && SCRIPT="$LOOK_SCRIPT"
[ $need_wall = 1 ] && SCRIPT="$SCRIPT
$WALL_SCRIPT"

lockscreen_nebula() {
	for r in kreadconfig6 kreadconfig5; do command -v $r >/dev/null 2>&1 && break; r=""; done
	for w in kwriteconfig6 kwriteconfig5; do command -v $w >/dev/null 2>&1 && break; w=""; done
	[ -n "$r" ] && [ -n "$w" ] || return 0
	cur=$($r --file kscreenlockerrc --group Greeter --group Wallpaper --group org.kde.image --group General --key Image 2>/dev/null)
	case "$cur" in
		""|*NovaAurora*|*/wallpapers/Next*)
			$w --file kscreenlockerrc --group Greeter --group Wallpaper --group org.kde.image --group General \
				--key Image "$NEBULA" 2>/dev/null
			$w --file kscreenlockerrc --group Greeter --group Wallpaper --group org.kde.image --group General \
				--key PreviewImage "${NEBULA}contents/images_dark/3840x2160.jpg" 2>/dev/null ;;
	esac
	return 0
}

# Plasma may still be starting: try for about a minute
i=0
while [ $i -lt 30 ]; do
	if busctl --user call org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell evaluateScript s "$SCRIPT" >/dev/null 2>&1; then
		mkdir -p "$STATE"
		if [ $need_look = 1 ]; then
			busctl --user call org.kde.KWin /KWin org.kde.KWin reconfigure >/dev/null 2>&1 || true
			echo "$VERSION" > "$STATE/look-version"
		fi
		if [ $need_wall = 1 ]; then
			lockscreen_nebula
			echo 2 > "$STATE/look-edition"
		fi
		exit 0
	fi
	i=$((i + 1))
	sleep 2
done
exit 0
