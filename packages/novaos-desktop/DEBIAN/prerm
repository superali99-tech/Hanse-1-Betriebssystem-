#!/bin/sh
set -e
if [ "$1" = remove ] || [ "$1" = purge ]; then
	/usr/lib/novaos/novaos-rebrand remove || true
	update-alternatives --remove novaos-login-background /usr/share/novaos/artwork/login-background.jpg >/dev/null 2>&1 || true
	if command -v plymouth-set-default-theme >/dev/null 2>&1 && \
	   [ "$(plymouth-set-default-theme 2>/dev/null)" = novaos ]; then
		plymouth-set-default-theme --reset || true
	fi
fi
exit 0
