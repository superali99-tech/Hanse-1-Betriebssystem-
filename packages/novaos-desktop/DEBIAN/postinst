#!/bin/sh
set -e

case "$1" in
	configure|triggered)
		/usr/lib/novaos/novaos-rebrand apply || echo "novaos-desktop: rebranding failed" >&2
		;;
esac

if [ "$1" = configure ]; then
	# Boot splash
	if command -v plymouth-set-default-theme >/dev/null 2>&1; then
		# NovaOS 2 (package novaos-2) has its own boot screen
		if [ -d /usr/share/plymouth/themes/novaos2 ] && [ "$(cat /usr/share/novaos/edition 2>/dev/null)" = 2 ]; then
			plymouth-set-default-theme novaos2 || true
		else
			plymouth-set-default-theme novaos || true
		fi
		if command -v update-initramfs >/dev/null 2>&1; then
			dpkg-trigger --no-await update-initramfs 2>/dev/null || true
		fi
	fi
	command -v gtk-update-icon-cache >/dev/null 2>&1 && gtk-update-icon-cache -q -f /usr/share/icons/hicolor || true
	# login screen background (NovaOS 2 adds its own with a higher priority)
	update-alternatives --install /usr/share/novaos/artwork/login-background-current.jpg \
		novaos-login-background /usr/share/novaos/artwork/login-background.jpg 10 >/dev/null 2>&1 || true
	# Desktop shortcuts must be executable to be trusted by Plasma
	chmod 0755 /etc/skel/Desktop/*.desktop 2>/dev/null || true
fi

# An update of novaos-desktop (login screen, start screen, desktop, system settings) takes
# effect after a restart: set Debian's "restart required" flag, so Nova Updates
# offers "Restart now" (not on the first installation).
if [ "$1" = configure ] && [ -n "$2" ] && [ -d /run ]; then
	touch /run/reboot-required 2>/dev/null || true
	echo novaos-desktop >> /run/reboot-required.pkgs 2>/dev/null || true
fi
exit 0
