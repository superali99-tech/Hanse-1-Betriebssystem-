#!/bin/sh
# Make the installed system bootable even if the firmware has no NVRAM boot
# entry for NovaOS (or loses it, which many PCs and virtual machines do):
# Debian's signed shim + GRUB are copied to the removable-media path
# EFI/BOOT/BOOTX64.EFI. shim's fallback (fbx64.efi) then re-creates the
# "NovaOS" boot entry from EFI/NovaOS/BOOTX64.CSV on the next start.
# The chain stays signed, so this works with Secure Boot as well.
#
# Found by the NovaOS QEMU installation test: without this step OVMF dropped
# to the UEFI shell after installation.
set -e
. /usr/lib/novaos/calamares/common.sh
T=$(target_root "$1")
[ -n "$T" ] || { log "target root not found"; exit 1; }
[ -d /sys/firmware/efi ] || { log "BIOS system - nothing to do"; exit 0; }

E="$T/boot/efi/EFI"
SRC=""
for d in NovaOS novaos debian; do
	if [ -f "$E/$d/shimx64.efi" ] || [ -f "$E/$d/grubx64.efi" ]; then
		SRC="$E/$d"
		break
	fi
done
if [ -z "$SRC" ]; then
	log "no GRUB/shim found below $E - cannot create fallback"
	exit 1
fi

mkdir -p "$E/BOOT"
if [ -f "$SRC/shimx64.efi" ]; then
	cp "$SRC/shimx64.efi" "$E/BOOT/BOOTX64.EFI"
	for f in grubx64.efi mmx64.efi fbx64.efi grub.cfg; do
		[ -f "$SRC/$f" ] && cp "$SRC/$f" "$E/BOOT/$f"
	done
else
	cp "$SRC/grubx64.efi" "$E/BOOT/BOOTX64.EFI"
	[ -f "$SRC/grub.cfg" ] && cp "$SRC/grub.cfg" "$E/BOOT/grub.cfg"
fi
log "EFI fallback installed: $(ls "$E/BOOT" | tr '\n' ' ')"

# Name the entry that shim's fallback creates "NovaOS" (Debian ships
# "debian"). BOOTX64.CSV is UCS-2 little endian.
if [ -f "$SRC/shimx64.efi" ] && command -v iconv >/dev/null 2>&1; then
	printf 'shimx64.efi,NovaOS,,This is the boot entry for NovaOS\n' \
		| iconv -f UTF-8 -t UCS-2LE > "$SRC/BOOTX64.CSV" || true
fi

# Register the NVRAM entry from the *live* system, where efivarfs is
# mounted (the QEMU test showed that the write from inside the target
# chroot did not end up in NVRAM). Harmless if it fails: then shim's
# fallback creates the entry at the first start.
if command -v efibootmgr >/dev/null 2>&1 && [ -d /sys/firmware/efi/efivars ]; then
	if ! efibootmgr 2>/dev/null | grep -qi 'novaos'; then
		ESP_DEV=$(findmnt -n -o SOURCE "$T/boot/efi" || true)
		DISK="/dev/$(lsblk -no PKNAME "$ESP_DEV" 2>/dev/null | head -n1)"
		PART=$(cat "/sys/class/block/$(basename "$ESP_DEV")/partition" 2>/dev/null || true)
		if [ -n "$PART" ] && [ -b "$DISK" ]; then
			LOADER='\EFI\NovaOS\grubx64.efi'
			[ -f "$SRC/shimx64.efi" ] && LOADER='\EFI\NovaOS\shimx64.efi'
			if efibootmgr -c -d "$DISK" -p "$PART" -L NovaOS -l "$LOADER" >/dev/null 2>&1; then
				log "NVRAM boot entry 'NovaOS' created ($DISK, partition $PART)"
			else
				log "NVRAM entry could not be created - shim fallback will create it"
			fi
		fi
	fi
fi
exit 0
