{
  "policies": {
    "DisableTelemetry": true,
    "DisableFirefoxStudies": true,
    "DisablePocket": true,
    "DontCheckDefaultBrowser": true,
    "OverrideFirstRunPage": "",
    "OverridePostUpdatePage": "",
    "UserMessaging": {
      "ExtensionRecommendations": false,
      "FeatureRecommendations": false,
      "UrlbarInterventions": false,
      "SkipOnboarding": true,
      "MoreFromMozilla": false
    },
    "EnableTrackingProtection": {
      "Value": true,
      "Cryptomining": true,
      "Fingerprinting": true
    },
    "HttpsOnlyMode": "enabled",
    "PasswordManagerEnabled": true,
    "OfferToSaveLogins": true,
    "Homepage": {
      "URL": "file:///usr/share/novaos/website/index.html",
      "StartPage": "homepage",
      "Locked": false
    },
    "ManagedBookmarks": [
      {
        "toplevel_name": "NovaOS"
      },
      {
        "name": "NovaOS – Start",
        "url": "file:///usr/share/novaos/website/index.html"
      },
      {
        "name": "Was ist neu",
        "url": "file:///usr/share/novaos/website/updates/aktuell.html"
      },
      {
        "name": "Alle Updates",
        "url": "file:///usr/share/novaos/website/updates/index.html"
      },
      {
        "name": "Anleitungen",
        "url": "file:///usr/share/novaos/website/anleitungen/index.html"
      }
    ],
    "DisplayBookmarksToolbar": "newtab",
    "Preferences": {
      "browser.tabs.unloadOnLowMemory": {
        "Value": true,
        "Status": "default"
      },
      "browser.sessionstore.interval": {
        "Value": 60000,
        "Status": "default"
      },
      "media.ffmpeg.vaapi.enabled": {
        "Value": true,
        "Status": "default"
      },
      "general.smoothScroll.msdPhysics.enabled": {
        "Value": true,
        "Status": "default"
      },
      "browser.tabs.min_inactive_duration_before_unload": {
        "Value": 300000,
        "Status": "default"
      },
      "browser.newtabpage.activity-stream.showSponsored": {
        "Value": false,
        "Status": "default"
      },
      "browser.newtabpage.activity-stream.showSponsoredTopSites": {
        "Value": false,
        "Status": "default"
      },
      "browser.urlbar.suggest.trending": {
        "Value": false,
        "Status": "default"
      }
    }
  }
}
