#!/bin/sh
set -e
if [ "$1" = configure ]; then
	mkdir -p /var/lib/novaos/updates
	chmod 0755 /var/lib/novaos /var/lib/novaos/updates
	if command -v systemctl >/dev/null 2>&1; then
		# User services for all users: update notification ("Update available",
		# at login, every 4 h and as soon as updates are ready), calendar reminders
		systemctl --global enable nova-update-notifier.timer nova-update-notifier.path \
			nova-calendar-reminders.service >/dev/null 2>&1 || true
		# Search for updates every 14 days, install them at the next restart
		systemctl enable novaos-update-check.timer >/dev/null 2>&1 || true
		if [ -d /run/systemd/system ]; then
			systemctl daemon-reload >/dev/null 2>&1 || true
			systemctl start novaos-update-check.timer >/dev/null 2>&1 || true
		fi
	fi
	command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database -q /usr/share/applications || true
	command -v gtk-update-icon-cache >/dev/null 2>&1 && gtk-update-icon-cache -q -f /usr/share/icons/hicolor || true
	# Byte-compile for faster start-up
	python3 -m compileall -q /usr/lib/python3/dist-packages/novaos >/dev/null 2>&1 || true
fi
exit 0
