#!/bin/sh
set -e
if [ "$1" = configure ]; then
	# Enable user services for all users (update notifier, calendar reminders)
	if command -v systemctl >/dev/null 2>&1; then
		systemctl --global enable nova-update-notifier.timer nova-calendar-reminders.service >/dev/null 2>&1 || true
	fi
	command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database -q /usr/share/applications || true
	# Byte-compile for faster start-up
	python3 -m compileall -q /usr/lib/python3/dist-packages/novaos >/dev/null 2>&1 || true
fi
exit 0
