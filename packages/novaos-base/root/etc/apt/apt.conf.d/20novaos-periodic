// NovaOS updates run every 14 days and are installed at the next restart
// (novaos-update-check.timer, /etc/novaos/updates.conf). The daily Debian
// mechanism is therefore off by default; "Additionally install security
// updates daily" in Nova Updates switches unattended-upgrades on.
APT::Periodic::Update-Package-Lists "0";
APT::Periodic::Unattended-Upgrade "0";
APT::Periodic::AutocleanInterval "7";
