#!/bin/sh
set -e

if [ "$1" = configure ]; then
	# NovaOS 2 (package novaos-2) brings its own os-release
	if [ -e /usr/lib/novaos/os-release-2 ]; then
		ln -sf /usr/lib/novaos/os-release-2 /usr/lib/os-release
	else
		ln -sf /usr/lib/novaos/os-release /usr/lib/os-release
	fi
	# /etc/os-release must point to /usr/lib/os-release (it can be a plain
	# copy after debootstrap).
	if [ ! -L /etc/os-release ]; then
		ln -sf ../usr/lib/os-release /etc/os-release
	fi

	# Flathub (system wide) for Nova Store
	if command -v flatpak >/dev/null 2>&1; then
		flatpak remote-add --system --if-not-exists flathub \
			/usr/share/novaos/flatpak/flathub.flatpakrepo || true
	fi

	# Firewall on by default (rules are applied by ufw.service at boot)
	if [ -f /etc/ufw/ufw.conf ] && [ ! -e /var/lib/novaos/ufw-configured ]; then
		sed -i 's/^ENABLED=.*/ENABLED=yes/' /etc/ufw/ufw.conf
		mkdir -p /var/lib/novaos && touch /var/lib/novaos/ufw-configured
	fi

	mkdir -p /var/log/journal

	# Upgrade from NovaOS 0.1.0: it installed security updates every day. Since 0.1.1
	# the default is the update every 14 days (at restart); keep the daily security
	# updates on for these PCs (the same switch as in Nova Updates). A setting the
	# user changed in Nova Updates is left alone.
	P=/etc/apt/apt.conf.d/20novaos-periodic
	if [ -n "$2" ] && dpkg --compare-versions "$2" lt 0.1.1 && [ -f "$P" ] && \
	   grep -q "NovaOS updates run every 14 days" "$P"; then
		cat > "$P" <<'EOT'
// Managed by Nova Updates: daily security updates in addition to the
// NovaOS update every 14 days (installed at restart)
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
APT::Periodic::AutocleanInterval "7";
EOT
	fi
fi

# An update of novaos-base (login screen, start screen, desktop, system settings) takes
# effect after a restart: set Debian's "restart required" flag, so Nova Updates
# offers "Restart now" (not on the first installation).
if [ "$1" = configure ] && [ -n "$2" ] && [ -d /run ]; then
	touch /run/reboot-required 2>/dev/null || true
	echo novaos-base >> /run/reboot-required.pkgs 2>/dev/null || true
fi
exit 0
