#!/usr/bin/python3 -I
"""Privileged helper of Nova Disk (pkexec): read-only access to whole drives.

    nova-disk-helper recover DEVICE OUTDIR GROUP...   PhotoRec: rescue files from DEVICE into OUTDIR
    nova-disk-helper health DEVICE                    SMART health (smartctl, JSON)

DEVICE must be a disk or partition (/dev/sdX, /dev/nvmeXnY, /dev/mmcblkX ...). OUTDIR must
belong to the calling user and must not be on a file system of DEVICE. The rescued files are
given to the calling user afterwards.
"""
import json
import os
import subprocess
import sys
import time

from novaos.disk import recovery

ENV = dict(PATH="/usr/sbin:/usr/bin:/sbin:/bin", LC_ALL="C.UTF-8", TERM="dumb")


def die(msg: str, code: int = 2) -> None:
    print("ERROR " + msg, flush=True)
    sys.exit(code)


def mounts_of(device: str) -> list[str]:
    res = subprocess.run(["lsblk", "-J", "-o", "PATH,MOUNTPOINTS", device], capture_output=True, text=True, env=ENV)
    out = []

    def walk(nodes):
        for n in nodes or []:
            out.extend(m for m in (n.get("mountpoints") or []) if m)
            walk(n.get("children"))
    try:
        walk(json.loads(res.stdout or "{}").get("blockdevices"))
    except ValueError:
        pass
    return out


def main(argv: list[str]) -> int:
    if len(argv) < 2:
        die("usage")
    uid = int(os.environ.get("PKEXEC_UID", "-1"))
    cmd, device = argv[0], argv[1]
    if not recovery.valid_device(device) or not os.path.exists(device):
        die("not a drive: " + device)
    if cmd == "health":
        res = subprocess.run(["smartctl", "-j", "-H", "-A", "-i", device], capture_output=True, text=True, env=ENV)
        print(res.stdout, flush=True)
        return 0
    if cmd == "recover" and len(argv) >= 4:
        outdir = os.path.realpath(argv[2])
        groups = [g for g in argv[3:] if g in recovery.FILE_GROUPS]
        try:
            st = os.stat(outdir)
        except OSError:
            die("target folder missing")
        if uid >= 0 and st.st_uid != uid:
            die("the target folder must be your own folder")
        if recovery.same_device(outdir, mounts_of(device)):
            die("same drive")
        print("STARTED", flush=True)
        stop = os.path.join(outdir, recovery.STOP_FILE)
        proc = subprocess.Popen(recovery.photorec_command(device, outdir, groups), cwd=outdir, env=ENV,
                                stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        while proc.poll() is None:   # Nova Disk asks to stop by creating the stop file
            if os.path.exists(stop):
                proc.terminate()
                break
            time.sleep(1)
        rc = proc.wait()
        try:
            os.unlink(stop)
        except OSError:
            pass
        if uid >= 0:   # the rescued files belong to the user
            for dp, dn, fn in os.walk(outdir):
                for n in dn + fn:
                    try:
                        os.lchown(os.path.join(dp, n), uid, -1)
                    except OSError:
                        pass
        print(f"DONE {rc} {recovery.found_files(outdir)}", flush=True)
        return 0 if rc == 0 else 1
    die("unknown command")
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
