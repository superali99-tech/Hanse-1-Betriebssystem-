<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>NovaOS</vendor>
  <action id="org.novaos.updates.apt-helper">
    <description>Manage system software</description>
    <description xml:lang="de">Systemsoftware verwalten</description>
    <message>Authentication is required to install updates or change update settings</message>
    <message xml:lang="de">Zum Installieren von Updates oder Ändern der Update-Einstellungen ist eine Authentifizierung erforderlich</message>
    <icon_name>nova-updates</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/novaos/nova-apt-helper</annotate>
  </action>
</policyconfig>
